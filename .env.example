# ==============================================================================
# Vagamundo — Configurações de Ambiente e Provedores de IA (OPCIONAL)
#
# NOTA DE INSTALAÇÃO MÍNIMA:
# Criar este arquivo manualmente é OPCIONAL. Ao iniciar o sistema com
# `npm run dev`, você pode configurar tudo direto pela aba "Configurações"
# em http://localhost:4200 — ela cria e protege o arquivo `backend/.env`
# automaticamente.
#
# SE PREFERIR CONFIGURAR PELO TERMINAL (único arquivo opcional):
# 1. Copie este arquivo para `.env` na raiz do projeto (ou `backend/.env`):
#      cp .env.example .env
# 2. Escolha o provedor em `AI_PROVIDER=` (auto, openai, gemini ou claude).
# 3. Preencha a respectiva chave de API abaixo (não é preciso para Ollama local
#    com OPENAI_BASE_URL nem para CLIs locais já autenticadas).
# 4. Defina AI_DATA_CONSENT=yes para habilitar o envio de vagas/perfil à IA.
#    NUNCA faça commit de nenhum arquivo `.env`!
# ==============================================================================

# Provedor ativo: auto, openai, gemini ou claude
AI_PROVIDER=auto

# Confirmação de privacidade (necessário "yes" para habilitar a IA)
AI_DATA_CONSENT=yes

# ------------------------------------------------------------------------------
# 1. Google Gemini (Possui plano gratuito)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. OpenAI / ChatGPT / Codex / Modelos Locais (Ollama)
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Para modelos locais (ex.: Ollama), defina OPENAI_BASE_URL=http://localhost:11434/v1
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Anthropic Claude
# Obtenha sua chave em: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
