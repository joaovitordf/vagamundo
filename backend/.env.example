# ==============================================================================
# Vagamundo — Configurações de Ambiente e Provedores de IA
#
# COMO USAR:
# 1. Copie este arquivo para `.env` na raiz do projeto:
#      cp .env.example .env
# 2. Escolha o provedor em `AI_PROVIDER=` (gemini, claude, openai ou auto).
# 3. Preencha a respectiva chave de API abaixo.
# 4. Inicie o sistema via `npm run dev` e acesse http://localhost:4200.
#    Você também pode testar ou alterar as chaves pela aba "Configurações" do painel.
#
# PRIVACIDADE:
# Defina AI_DATA_CONSENT=yes para permitir que o sistema avalie vagas e elabore
# materiais com o provedor de IA escolhido. NUNCA faça commit do arquivo `.env`!
# ==============================================================================

# Provedor ativo: gemini, claude, openai (ou auto)
AI_PROVIDER=gemini

# Confirmação de privacidade (necessário "yes" para habilitar a IA)
AI_DATA_CONSENT=yes

# ------------------------------------------------------------------------------
# 1. Google Gemini (Recomendado)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Anthropic Claude
# Obtenha sua chave em: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# 3. OpenAI / ChatGPT / Modelos Locais (Ollama)
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Para modelos locais (ex: Ollama), defina OPENAI_BASE_URL=http://localhost:11434/v1
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
