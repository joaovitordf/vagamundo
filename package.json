{
  "name": "vagamundo",
  "version": "2.0.0",
  "private": true,
  "description": "Vagamundo - Assistente Inteligente de Vagas e Carreira",
  "scripts": {
    "dev": "node dev.js",
    "start": "node dev.js",
    "install:all": "npm install && node install.js",
    "install:portals": "node install.js --portals-only",
    "backend": "node -e \"const {spawnSync}=require('child_process'),{findPython}=require('./install'),py=findPython()||{cmd:'python',prefixArgs:[]};process.exit(spawnSync(py.cmd,[...py.prefixArgs,'-m','uvicorn','backend.api.app:app','--reload','--port','8765','--host','127.0.0.1'],{stdio:'inherit'}).status||0)\"",
    "frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  }
}
